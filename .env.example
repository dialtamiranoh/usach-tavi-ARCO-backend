# Copiar como .env y ajustar según el entorno local
# Iniciar con: uvicorn main:app --port 8000 --reload

# --- Modelo Granite (puerto 8001) ---
GRANITE_URL=http://127.0.0.1:8001/v1/chat/completions
GRANITE_MODEL=granite-3.1-2b-instruct

# --- Modelo Qwen (puerto 8002) ---
QWEN_URL=http://127.0.0.1:8002/v1/chat/completions
QWEN_MODEL=qwen2.5-1.5b-instruct

# --- Parámetros de generación ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=140

# --- RAG (opcional) ---
USE_RAG=false

PROMPT_VERSION=1.0.0
