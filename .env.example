# Copiar como .env y ajustar según el entorno local
# Iniciar backend de producción con: uvicorn main:app --port 8000 --reload
# Iniciar backend de benchmark con: uvicorn dashboard:app --port 8090 --reload

# --- Modelo LLM de producción (main.py sirve uno solo via HTTP) ---
LLM_URL=http://127.0.0.1:8001/v1/chat/completions
LLM_MODEL_ID=granite-3.1-3b-instruct
LLM_LABEL=Granite-3.1-3B

# --- Parámetros de generación ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=140

# --- RAG (opcional) ---
USE_RAG=false

# --- Versión de prompts ---
PROMPT_VERSION=1.1.0

# ---------------------------------------------------------------------------
# dashboard.py — benchmark independiente (uvicorn dashboard:app --port 8090)
# ---------------------------------------------------------------------------

# Carpetas donde buscar .gguf, separadas por ";" (además de ../modelos/ por defecto)
DASHBOARD_MODEL_DIRS=

# Host/puerto base para los llama_cpp.server que dashboard.py lanza automáticamente
DASHBOARD_LLAMA_HOST=127.0.0.1
DASHBOARD_LLAMA_PORT_START=8600

# Contexto por defecto y timeout de arranque (segundos) al levantar un modelo
DASHBOARD_N_CTX=2048
DASHBOARD_HEALTH_TIMEOUT=180

# Fuerza un n_threads fijo por modelo en vez de repartir automáticamente
# los hilos de CPU detectados entre los modelos activos. Vacío = automático.
DASHBOARD_N_THREADS=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (opcional para canal móvil)
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=arco_tavi_2026
WHATSAPP_GRAPH_VERSION=v22.0

# Mapeo de números del equipo a nombres, para ver consultas por integrante en el dashboard de métricas.
# Formato: Nombre:numero,Nombre:numero
WHATSAPP_TEAM=Diego:56900000001,Roberto:56974331446,Pablo:56900000003,Gianello:56900000004

