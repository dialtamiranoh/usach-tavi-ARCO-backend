# Copiar como .env y ajustar según el entorno local
# Iniciar con: python main.py   (o  uvicorn main:app --port 8000 --reload)
# El modelo LLM se carga automáticamente al iniciar, no requiere otro proceso.

# --- Modelo (carga automática desde carpeta de modelos) ---
# Carpeta donde están los .gguf. Por defecto ../modelos (sibling del repo backend).
MODEL_DIR=../modelos
# Pista para preferir un modelo si hay varios .gguf en MODEL_DIR (busca esta palabra en la ruta).
# qwen es el modelo activo recomendado: granite-4.0-1b usa una arquitectura hibrida
# Mamba2+atencion muy nueva que llama-cpp-python aun no soporta bien (genera texto
# incoherente). Qwen2.5-3B es una arquitectura transformer estandar y funciona correctamente.
MODEL_NAME=qwen
# Ruta directa a un .gguf específico. Si se define, ignora MODEL_DIR/MODEL_NAME.
# MODEL_PATH=C:/ruta/al/modelo.gguf
# Nombre para mostrar en el dashboard. Si se omite, se infiere del nombre del archivo.
# MODEL_LABEL=Qwen2.5-3B

LLM_N_CTX=2048
# Si se omite, usa todos los núcleos lógicos disponibles (recomendado).
# Fijar un número más bajo solo si quieres dejar CPU libre para otras apps mientras corre ARCO.
# LLM_N_THREADS=4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=140

# --- RAG (opcional) ---
USE_RAG=false

PROMPT_VERSION=1.0.0

# --- WhatsApp Cloud API (opcional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=arco_tavi_verify_token
WHATSAPP_GRAPH_VERSION=v22.0

# Mapeo de números del equipo a nombres, para ver consultas por integrante en el dashboard.
# Formato: Nombre:numero,Nombre:numero
WHATSAPP_TEAM=Diego:56900000001,Roberto:56974331446,Pablo:56900000003,Gianello:56900000004

# --- Solo para tests / CI: evita cargar el modelo .gguf ---
# ARCO_SKIP_MODEL_LOAD=true
